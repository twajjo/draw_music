# Copy to .env for docker compose (and keep .env out of version control).

# mix phx.gen.secret
SECRET_KEY_BASE=

# The name testers use to reach the app, e.g. music.example.com
PHX_HOST=localhost

# Optional
# POSTGRES_PASSWORD=change-me
# SAMPLES_DIR=/data/samples   # a writable volume, instead of the samples built into the image
